# =============================================================================
# Sub2API Single-Server Docker Deployment Environment
# =============================================================================
# Copy to .env.db or run:
#   bash deploy-db.sh
# =============================================================================

COMPOSE_PROJECT_NAME=sub2api
SUB2API_IMAGE=sub2api:local

BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=sub2api
POSTGRES_MAX_CONNECTIONS=512
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_MAINTENANCE_WORK_MEM=128MB

DATABASE_MAX_OPEN_CONNS=256
DATABASE_MAX_IDLE_CONNS=128
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAXCLIENTS=50000
REDIS_POOL_SIZE=4096
REDIS_MIN_IDLE_CONNS=256

ADMIN_EMAIL=admin@sub2api.local
# Leave empty to auto-generate on first startup and print in logs.
ADMIN_PASSWORD=

# Generate fixed secrets for production:
#   openssl rand -hex 32
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRE_HOUR=24
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=0
TOTP_ENCRYPTION_KEY=change_this_totp_encryption_key

LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE_NAME=sub2api
LOG_ENV=production
LOG_OUTPUT_TO_STDOUT=true
LOG_OUTPUT_TO_FILE=true

# Build download mirrors. Use direct settings if the server can access upstream.
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
